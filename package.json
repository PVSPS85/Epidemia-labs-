{
  "name": "epidemia-labs-root",
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install concurrently && cd frontend && npm install",
    "dev:backend": "uvicorn main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "concurrently": "^8.2.2"
  }
}
